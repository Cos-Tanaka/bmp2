# Backlog 接続設定
BACKLOG_SPACE=yourspace.backlog.com
BACKLOG_API_KEY=your_api_key_here
BACKLOG_PROJECT_KEY=ASPIT

# キャッシュ TTL（秒）
CACHE_TTL=60

# カスタム属性名設定（未指定時のデフォルト値が右辺）
# PROGRESS_FIELD_NAME=進捗率
# STATUS_FIELD_NAME=ステータス
# CHECK_STATUS_FIELD_NAME=チェック状態

# 保守作業（FIX-MAINT）実績の取り込み元スプレッドシート（日別実績画面の「取得」ボタン用）
# シートはリンクを知っていれば閲覧可能な公開設定である必要がある
# MAINTENANCE_SHEET_ID=1-0b0YAFgMRdSJ38r6XwvGubJf3_nK1TgCzd939P17PY
# MAINTENANCE_SHEET_GID=0
